{
  "author": "Dennis Gerike",
  "dependencies": {
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "compression": "1.8.2",
    "copyfiles": "2.4.1",
    "cors": "2.8.6",
    "currency-codes": "2.2.0",
    "express": "5.3.0",
    "i18n-iso-countries": "7.14.0",
    "inflection": "3.0.2",
    "iso-639-1": "3.1.6",
    "neo4j-driver": "6.2.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "description": "REST API for the open car database 'More Cars'",
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@inquirer/prompts": "8.7.4",
    "@redocly/cli": "2.69.0",
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@types/k6": "2.3.0",
    "@types/supertest": "7.2.1",
    "@usebruno/cli": "4.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "8.20.0",
    "change-case": "5.4.4",
    "dotenv": "18.0.8",
    "eslint": "10.13.0",
    "hygen": "6.2.11",
    "inquirer": "14.2.4",
    "inquirer-file-selector": "1.0.1",
    "moment": "2.31.0",
    "supertest": "7.3.1",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=26"
  },
  "license": "MIT",
  "name": "@more-cars/rest-api",
  "repository": "https://github.com/more-cars/rest-api",
  "scripts": {
    "build": "npm run build:code && npm run build:assets",
    "build:code": "tsc -p tsconfig.app.json",
    "build:assets": "copyfiles -u 1 'src/**/*.cypher' dist",
    "start": "NODE_ENV=production node dist/server.js",
    "local:app:start": "./deployment/local-app-start.sh",
    "local:db:start": "./deployment/local-db-start.sh",
    "local:hostnames:add": "./deployment/add-local-hostnames.sh",
    "app:deploy": "./deployment/deploy-app.sh",
    "app:undeploy": "./deployment/undeploy-app.sh",
    "db:restore": "./deployment/restore-database.sh",
    "minikube:install": "deployment/minikube-install.sh",
    "minikube:start": "deployment/minikube-cluster-start.sh",
    "minikube:stop": "deployment/minikube-cluster-stop.sh",
    "minikube:delete": "deployment/minikube-cluster-delete.sh",
    "generate-code": "TS_NODE_PROJECT=tsconfig.app.json node --env-file=.env -r ts-node/register code_generator/generate-code-for-feature.ts",
    "generate-code:image-relationships": "TS_NODE_PROJECT=tsconfig.app.json node --env-file=.env -r ts-node/register code_generator/generate-code-for-images.ts",
    "generate-code:video-relationships": "TS_NODE_PROJECT=tsconfig.app.json node --env-file=.env -r ts-node/register code_generator/generate-code-for-videos.ts",
    "tests:validate-api-schema": "npx ts-node tests/api-validation/schema-validation.ts",
    "tests:lint:src": "npx eslint src",
    "tests:lint:tests": "npx eslint tests",
    "tests:unit": "npx vitest run -c tests/unit/vite.config.ts",
    "tests:integration": "npx vitest run -c tests/integration/vite.config.ts",
    "tests:developer": "./tests/developer/run-tests.sh",
    "tests:smoke:gui": "npm run start --workspace=@more-cars/rest-api-mock-servers & bruno",
    "tests:smoke:cli": "./tests/smoke/run-smoke-tests.sh",
    "tests:behavior": "TS_NODE_PROJECT=tests/behavior/tsconfig.json node --env-file=.env -r ts-node/register tests/behavior/check-dependencies.ts true && TS_NODE_PROJECT=mock-servers/tsconfig.json npm run start --workspace=@more-cars/rest-api-mock-servers & TS_NODE_PROJECT=tsconfig.test.json npx cucumber-js --tags '@implemented and not @deactivated'",
    "tests:behavior:single": "TS_NODE_PROJECT=tests/behavior/tsconfig.json node --env-file=.env -r ts-node/register tests/behavior/run-single-test.ts",
    "tests:performance": "./tests/performance/run-tests.sh"
  },
  "workspaces": [
    "mock-servers",
    "statistics"
  ],
  "version": "2.0.8"
}
